# Docker Compose configuration (copy to .env in the project root)
# Set a password before starting a NEW database.
# An existing MySQL data volume requires its original password.
MYSQL_ROOT_PASSWORD=change-me-before-deploy
MYSQL_DATABASE=badminton1

# Branding
APP_NAME="Sports Club Manager"
ORG_NAME="My Sports Club"
EMAIL_DOMAIN=

# SMTP (optional — required for password reset email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
